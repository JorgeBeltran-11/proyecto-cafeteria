{
  "name": "cafeteria",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter api --filter web dev",
    "lint": "pnpm -r lint && pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:setup": "pnpm --filter api db:setup",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
