# Variables de entorno de la API. Copia este archivo a apps/api/.env (no contiene secretos).

# Conexión de Prisma con la base de datos. Con SQLite, la ruta es relativa a apps/api/prisma/.
DATABASE_URL="file:./dev.db"

# Puerto HTTP en el que escucha la API (por defecto 3001).
PORT=3001

# Origen permitido por CORS: la URL de la web (por defecto http://localhost:3000).
WEB_ORIGIN=http://localhost:3000
