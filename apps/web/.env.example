# Variables de entorno de la web. Copia este archivo a apps/web/.env.local (no contiene secretos).

# URL base de la API que consulta la página de inicio (GET /health).
NEXT_PUBLIC_API_URL=http://localhost:3001

# La web escucha en el puerto 3000. Para cambiarlo, define la variable de entorno PORT
# al arrancar (por ejemplo, PORT=4000 pnpm --filter web dev); Next.js no la lee de este archivo.
