// Esquema Prisma - Spec 002: Identidad.
// Identidad administra credenciales y autenticación.
// Los datos personales pertenecen al módulo Clientes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id              String    @id @default(uuid())
  clientId        String?   @unique
  passwordHash    String
  role            String    @default("customer")
  status          String    @default("pending_confirmation")
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                UserSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  mfaSecret               MfaSecret?
  recoveryCodes           MfaRecoveryCode[]
  mfaChallenges           MfaChallenge[]
  securityEvents          SecurityEvent[]

  @@index([role, status])
}

model UserSession {
  id         String    @id @default(uuid())
  accountId  String
  userAgent  String?
  ipHash     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([accountId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id                String    @id @default(uuid())
  sessionId         String
  tokenHash         String    @unique
  familyId          String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, usedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, usedAt])
  @@index([expiresAt])
}

model MfaSecret {
  id              String    @id @default(uuid())
  accountId       String    @unique
  status          String    @default("pending_activation")
  secretEncrypted String
  enabledAt       DateTime?
  lastVerifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  accountId String
  codeHash  String    @unique
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, usedAt])
}

model MfaChallenge {
  id        String    @id @default(uuid())
  accountId String
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, usedAt])
  @@index([expiresAt])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  accountId String?
  eventType String
  eventAt   DateTime @default(now())
  ipHash    String?
  metadata  String?

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, eventAt])
  @@index([eventType, eventAt])
}

model ClientProfile {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  phone       String?
  preferences Json?
  locale      String   @default("es-EC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConsentRecord {
  id            String   @id @default(uuid())
  clientId      String
  purpose       String
  state         String
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  source        String   @default("self-service")
  createdAt     DateTime @default(now())

  @@index([clientId, purpose, effectiveFrom])
}

model DataRightsRequest {
  id          String    @id @default(uuid())
  clientId    String
  requestType String
  status      String    @default("pending")
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  @@index([clientId, status])
  @@index([requestedAt])
}

// Cada spec añade aquí sus modelos: 002 (identidad), 003 (catalogo) y 004 (carrito).

// ---------------------------------------------------------------------------
// Módulo carrito (spec 004, data-model.md). Tablas propiedad exclusiva del módulo.
// clienteId y productoId son ids de identidad y catálogo: sin claves foráneas
// hacia sus tablas, porque cada módulo es dueño de su esquema (constitución V).
// ---------------------------------------------------------------------------

model Carrito {
  id            String         @id @default(cuid())
  clienteId     String         @unique
  actualizadoEn DateTime
  lineas        LineaCarrito[]
}

model LineaCarrito {
  id                  String   @id @default(cuid())
  carritoId           String
  productoId          String
  cantidad            Int
  /// Precio que vio el cliente al añadir la línea o al aceptar el último cambio.
  precioVistoCentavos Int
  anadidaEn           DateTime
  carrito             Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)

  @@unique([carritoId, productoId])
}

// ---------------------------------------------------------------------------
// Módulo catalogo (spec 003, data-model.md). Tablas propiedad exclusiva del módulo.
// Los campos JSON se guardan como texto (research R8).
// ---------------------------------------------------------------------------

model Producto {
  /// Lo elige el administrador (p. ej. "capuchino"); es el id que usan la web y el carrito.
  id             String   @id
  nombre         String
  descripcion    String
  precioCentavos Int
  imagenUrl      String?
  imagenAlt      String?
  /// JSON Alergeno[]; null = alérgenos sin declarar (bloquea la publicación).
  alergenos      String?
  agotado        Boolean  @default(false)
  /// null = el producto no controla existencias.
  existencias    Int?
  retirado       Boolean  @default(false)
  revision       Int      @default(1)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt
}

model Menu {
  id               String        @id @default(cuid())
  /// borrador | publicado | retirado
  estado           String
  /// JSON { nombre, horario, categorias: [{ nombre, productoIds }] }
  borrador         String
  versionPublicada Int?
  revision         Int           @default(1)
  creadoEn         DateTime      @default(now())
  actualizadoEn    DateTime      @updatedAt
  versiones        VersionMenu[]
}

/// Instantánea inmutable de un menú publicado (FR-005).
model VersionMenu {
  id           String   @id @default(cuid())
  menuId       String
  numero       Int
  /// JSON ContenidoVersion
  contenido    String
  /// JSON string[]: resumen de cambios respecto a la versión anterior
  cambios      String
  publicadaPor String
  publicadaEn  DateTime
  restauradaDe Int?
  menu         Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, numero])
}

/// Registro de auditoría del catálogo (FR-012).
model CambioCatalogo {
  id        String   @id @default(cuid())
  entidad   String
  entidadId String
  accion    String
  usuarioId String
  /// JSON con el detalle del cambio
  detalle   String
  fecha     DateTime @default(now())

  @@index([entidad, entidadId])
}
