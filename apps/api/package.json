{
  "name": "api",
  "version": "0.0.1",
  "description": "API de la cafetería (NestJS + Prisma).",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "build": "prisma generate && nest build",
    "postinstall": "prisma generate",
    "db:setup": "prisma migrate deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests && jest --config test/jest-e2e.json --passWithNoTests"
  },
  "dependencies": {
    "@cafeteria/shared": "workspace:*",
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@prisma/client": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prisma": "6.19.3",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
